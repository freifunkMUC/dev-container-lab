diff --git a/group_vars/all/vars b/group_vars/all/vars
index b3bca6b..a29f6ac 100644
--- a/group_vars/all/vars
+++ b/group_vars/all/vars
@@ -17,8 +17,31 @@ private_ipv4_range: '10.0.0.0/16'
 # locally, so all of them use the same one.
 client_ipv4_range: '10.0.4.0/22'
 
-global_ipv6_range_without_prefix: '2001:db8:ff00'
+# Multi-PoP (LAB): two sites. Each site has its own /48 and its own IPv4
+# addresses, and announces only those. There is no routing between the sites.
+# The nodes get one /63 from the Parker pool of each site, and use the DNS64
+# server of the site through the tunnel to that site. wgkex_pop in host_vars
+# puts each gateway in its site.
+multipop_sites:
+  pop-a:
+    site: muc01
+    range6_without_prefix: '2001:db8:a'
+    pool6: '2001:db8:a::/50'
+    dns64: '2001:db8:a::53'
+    ipam_file: "{{ wgkex_ipam_file }}"
+    # The site that a node without caps=multiprefix (old firmware) gets.
+    primary: true
+  pop-b:
+    site: vie01
+    range6_without_prefix: '2001:db8:b'
+    pool6: '2001:db8:b::/50'
+    dns64: '2001:db8:b::53'
+    ipam_file: /var/local/wgkex/broker/ipv6_ranges_b.json
+
+global_ipv6_range_without_prefix: "{{ multipop_sites[wgkex_pop].range6_without_prefix }}"
 global_ipv6_range_prefix: '48'
+dns64_ipv6: "{{ multipop_sites[wgkex_pop].dns64 }}"
+wgkex_sites_file: /etc/wgkex-sites.json
 # One /63 per node, allocated from the range above. wgkex splits it into the
 # /64 the node's clients live in and the /64 its CLAT translates into.
 node_ipv6_prefix_length: 63
