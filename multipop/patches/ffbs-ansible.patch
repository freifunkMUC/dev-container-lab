diff --git a/roles/wgkex/tasks/main.yml b/roles/wgkex/tasks/main.yml
index 3a7f8a9..158f7ce 100644
--- a/roles/wgkex/tasks/main.yml
+++ b/roles/wgkex/tasks/main.yml
@@ -66,13 +66,25 @@
 # The JSON IPAM only allocates from the prefix it finds in this file, so it has
 # to exist before the broker answers its first request. It also keeps the
 # concentrators picked per node in here, which is what makes the selection stick.
-- name: Seed the IPAM prefix pool
+# Multi-PoP (LAB): one pool per site. The pool of the first site is the main
+# IPAM file, so the top-level answer of the broker stays as before.
+- name: Seed the IPAM prefix pools
   ansible.builtin.copy:
     content: |
-      {"parent_prefix": "{{ global_ipv6_range_without_prefix }}::/{{ global_ipv6_range_prefix }}", "ranges": {}, "concentrators": {}}
-    dest: "{{ wgkex_ipam_file }}"
+      {"parent_prefix": "{{ item.value.pool6 }}", "ranges": {}, "concentrators": {}}
+    dest: "{{ item.value.ipam_file }}"
     mode: '0640'
     force: false
+  loop: "{{ multipop_sites | dict2items }}"
+  when: inventory_hostname in groups['Brokers']
+
+- name: Tell the broker the sites
+  ansible.builtin.copy:
+    content: "{{ multipop_sites | dict2items | items2dict | to_nice_json }}"
+    dest: "{{ wgkex_sites_file }}"
+    mode: '0644'
+  notify:
+    - Restart wgkex broker
   when: inventory_hostname in groups['Brokers']
 
 - name: Install wgkex broker unit
