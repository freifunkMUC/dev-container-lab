diff --git a/roles/dns64/tasks/main.yml b/roles/dns64/tasks/main.yml
new file mode 100644
index 0000000..900a2c9
--- /dev/null
+++ b/roles/dns64/tasks/main.yml
@@ -0,0 +1,43 @@
+---
+# Multi-PoP (LAB): the DNS64 server of the site. Both gateways of a site
+# answer on the same address (dns64_ipv6), and FRR announces it.
+- name: Install unbound
+  ansible.builtin.apt:
+    name: unbound
+    state: present
+
+- name: Configure unbound as DNS64
+  ansible.builtin.template:
+    src: dns64.conf.j2
+    dest: /etc/unbound/unbound.conf.d/dns64.conf
+    mode: '0644'
+  notify: Restart unbound
+
+- name: Add the lab test zone
+  ansible.builtin.copy:
+    src: test.lab.zone
+    dest: /etc/unbound/test.lab.zone
+    mode: '0644'
+  notify: Restart unbound
+
+- name: Create the unbound drop-in directory
+  ansible.builtin.file:
+    path: /etc/systemd/system/unbound.service.d
+    state: directory
+    mode: '0755'
+
+# The address must exist before FRR can announce it.
+- name: Put the DNS64 address on lo
+  ansible.builtin.copy:
+    content: |
+      [Service]
+      ExecStartPre=-/usr/sbin/ip -6 addr replace {{ dns64_ipv6 }}/128 dev lo
+    dest: /etc/systemd/system/unbound.service.d/dns64.conf
+    mode: '0644'
+  notify: Restart unbound
+
+- name: Enable unbound
+  ansible.builtin.systemd_service:
+    daemon_reload: true
+    name: unbound.service
+    enabled: true
diff --git a/roles/dns64/templates/dns64.conf.j2 b/roles/dns64/templates/dns64.conf.j2
new file mode 100644
index 0000000..21d522f
--- /dev/null
+++ b/roles/dns64/templates/dns64.conf.j2
@@ -0,0 +1,18 @@
+#{{ ansible_managed }}
+server:
+    interface: {{ dns64_ipv6 }}
+    interface-automatic: no
+    ip-freebind: yes
+    access-control: ::/0 allow
+    access-control: 0.0.0.0/0 allow
+    module-config: "dns64 iterator"
+    dns64-prefix: 64:ff9b::/96
+    # The lab has no root servers. Only the test zone resolves.
+    do-not-query-localhost: no
+
+auth-zone:
+    name: "test.lab"
+    zonefile: /etc/unbound/test.lab.zone
+    for-downstream: no
+    for-upstream: yes
+    fallback-enabled: no
