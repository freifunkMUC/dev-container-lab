diff --git a/wgkex/worker/handshake_routes.py b/wgkex/worker/handshake_routes.py
new file mode 100644
index 0000000..c34f6d9
--- /dev/null
+++ b/wgkex/worker/handshake_routes.py
@@ -0,0 +1,168 @@
+"""LAB PROTOTYPE: install a node /63 route only while its handshake is fresh.
+
+In the multi-PoP design every pgw of a site has the peer of every node of the
+site. Only the pgw with a live session may announce the /63 of the node. So
+the route follows the handshake, and the peer stays.
+
+Set WGKEX_ROUTE_ON_HANDSHAKE=<seconds> (for example 180) to enable it.
+
+When a node moves to another pgw of the same site, the broker tells the old
+pgw to drop the route at once (drop_route). The old pgw then keeps the route
+away until the node makes a new handshake with it. The timeout stays as a
+safety net only.
+"""
+
+import os
+import socket
+import threading
+from time import time
+from typing import Callable, Dict, Optional
+
+import pyroute2
+import pyroute2.netlink.exceptions
+
+from wgkex.common import logger
+from wgkex.worker import netlink
+
+INTERFACE = "wg-nodes"
+SYNC_INTERVAL = 1.0
+
+# prefix -> time of the drop request. A route comes back only after a
+# handshake that is newer than the drop.
+_dropped: Dict[str, float] = {}
+_dropped_lock = threading.Lock()
+
+
+def fresh_seconds() -> Optional[float]:
+    value = os.environ.get("WGKEX_ROUTE_ON_HANDSHAKE", "")
+    return float(value) if value else None
+
+
+def wanted_routes(
+    peers: list,
+    prefix_length: int,
+    fresh: float,
+    now: float,
+    dropped: Optional[Dict[str, float]] = None,
+) -> Dict[str, bool]:
+    """Maps the /63 of each peer to True if its handshake is fresh and newer
+    than a drop request for the prefix."""
+    dropped = dropped or {}
+    wanted: Dict[str, bool] = {}
+    for peer in peers:
+        try:
+            prefix = netlink._parker_prefix(peer, prefix_length)
+            handshake = netlink._last_handshake_seconds(peer)
+        except (ValueError, AttributeError):
+            continue
+        is_fresh = (
+            bool(handshake)
+            and now - handshake < fresh
+            and handshake > dropped.get(prefix, 0)
+        )
+        wanted[prefix] = wanted.get(prefix, False) or is_fresh
+    return wanted
+
+
+def sync_routes(
+    prefix_length: int, fresh: float, clock: Callable[[], float] = time
+) -> None:
+    with pyroute2.WireGuard() as wg:
+        peers = []
+        for msg in netlink._wireguard_info(wg, INTERFACE):
+            peers.extend(msg.get_attr("WGDEVICE_A_PEERS") or [])
+    with _dropped_lock:
+        dropped = dict(_dropped)
+    wanted = wanted_routes(peers, prefix_length, fresh, clock(), dropped)
+    with _dropped_lock:
+        for prefix, is_fresh in wanted.items():
+            if is_fresh:
+                _dropped.pop(prefix, None)
+    with pyroute2.IPRoute() as ip:
+        oif = ip.link_lookup(ifname=INTERFACE)[0]
+        present = {
+            f"{route.get_attr('RTA_DST')}/{route['dst_len']}"
+            for route in ip.get_routes(family=socket.AF_INET6, oif=oif)
+            if route["dst_len"] == prefix_length
+        }
+        for prefix, is_fresh in wanted.items():
+            if is_fresh == (prefix in present):
+                continue
+            try:
+                ip.route("replace" if is_fresh else "del", dst=prefix, oif=oif)
+                logger.info(
+                    "Handshake route %s %s",
+                    "installed" if is_fresh else "removed",
+                    prefix,
+                )
+            except pyroute2.netlink.exceptions.NetlinkError as error:
+                logger.warning("Handshake route %s failed: %s", prefix, error)
+
+
+def prefixes_to_drop(
+    peers: list, public_key: str, prefix_length: int, at: float
+) -> list:
+    """The prefixes of the peer, unless it made a handshake after time at."""
+    prefixes = []
+    for peer in peers:
+        try:
+            if netlink._peer_public_key(peer) != public_key:
+                continue
+            prefix = netlink._parker_prefix(peer, prefix_length)
+            handshake = netlink._last_handshake_seconds(peer)
+        except (UnicodeDecodeError, ValueError, AttributeError):
+            continue
+        if handshake and handshake > at:
+            logger.info("Not dropping %s of %s: newer handshake", prefix, public_key)
+            continue
+        prefixes.append(prefix)
+    return prefixes
+
+
+def drop_route(
+    public_key: str,
+    prefix_length: int,
+    clock: Callable[[], float] = time,
+    at: Optional[float] = None,
+) -> list:
+    """Removes the /63 route of a peer at once and keeps the peer.
+
+    at: the time of the switch report. A handshake that is newer than this
+    time means that the node came back to this pgw, so the route stays."""
+    now = clock()
+    at = now if at is None else min(float(at), now)
+    with pyroute2.WireGuard() as wg:
+        peers = []
+        for msg in netlink._wireguard_info(wg, INTERFACE):
+            peers.extend(msg.get_attr("WGDEVICE_A_PEERS") or [])
+    prefixes = prefixes_to_drop(peers, public_key, prefix_length, at)
+    with _dropped_lock:
+        for prefix in prefixes:
+            _dropped[prefix] = max(_dropped.get(prefix, 0), at)
+    with pyroute2.IPRoute() as ip:
+        oif = ip.link_lookup(ifname=INTERFACE)[0]
+        for prefix in prefixes:
+            try:
+                ip.route("del", dst=prefix, oif=oif)
+                logger.info("Dropped route %s of %s on request", prefix, public_key)
+            except pyroute2.netlink.exceptions.NetlinkError as error:
+                logger.info("Drop route %s: %s", prefix, error)
+    return prefixes
+
+
+def start(exit_event: threading.Event, prefix_length: int) -> Optional[threading.Thread]:
+    fresh = fresh_seconds()
+    if fresh is None:
+        return None
+    logger.info("Routes follow handshakes (lab prototype), fresh=%ss", fresh)
+
+    def loop() -> None:
+        while not exit_event.wait(SYNC_INTERVAL):
+            try:
+                sync_routes(prefix_length, fresh)
+            except Exception as error:
+                logger.error("Handshake route sync failed", exc_info=error)
+
+    thread = threading.Thread(target=loop, name="handshake-routes")
+    thread.start()
+    return thread
diff --git a/wgkex/worker/handshake_routes_test.py b/wgkex/worker/handshake_routes_test.py
new file mode 100644
index 0000000..557bc06
--- /dev/null
+++ b/wgkex/worker/handshake_routes_test.py
@@ -0,0 +1,58 @@
+import unittest
+
+from wgkex.worker import handshake_routes
+
+
+class _Peer:
+    def __init__(self, prefix, handshake, key="key"):
+        self.attrs = {
+            "WGPEER_A_PUBLIC_KEY": key,
+            "WGPEER_A_ALLOWEDIPS": [{"addr": prefix}],
+            "WGPEER_A_LAST_HANDSHAKE_TIME": {"tv_sec": handshake},
+        }
+
+    def get_attr(self, name):
+        return self.attrs.get(name)
+
+
+class HandshakeRoutesTest(unittest.TestCase):
+    def test_route_follows_fresh_handshake(self):
+        peers = [
+            _Peer("2001:db8:a::/63", 1000),
+            _Peer("2001:db8:a:2::/63", 700),
+            _Peer("2001:db8:a:4::/63", 0),
+        ]
+        self.assertEqual(
+            handshake_routes.wanted_routes(peers, 63, 180, 1100),
+            {
+                "2001:db8:a::/63": True,
+                "2001:db8:a:2::/63": False,
+                "2001:db8:a:4::/63": False,
+            },
+        )
+
+    def test_dropped_route_needs_newer_handshake(self):
+        peers = [_Peer("2001:db8:a::/63", 1000)]
+        dropped = {"2001:db8:a::/63": 1050}
+        self.assertEqual(
+            handshake_routes.wanted_routes(peers, 63, 180, 1100, dropped),
+            {"2001:db8:a::/63": False},
+        )
+        peers = [_Peer("2001:db8:a::/63", 1060)]
+        self.assertEqual(
+            handshake_routes.wanted_routes(peers, 63, 180, 1100, dropped),
+            {"2001:db8:a::/63": True},
+        )
+
+    def test_drop_skips_peer_that_came_back(self):
+        peers = [_Peer("2001:db8:a::/63", 1000), _Peer("2001:db8:a:2::/63", 0, "x")]
+        self.assertEqual(
+            handshake_routes.prefixes_to_drop(peers, "key", 63, 1050),
+            ["2001:db8:a::/63"],
+        )
+        # A late (retained) drop must not remove a session that is newer.
+        self.assertEqual(handshake_routes.prefixes_to_drop(peers, "key", 63, 990), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
