index 0000000..3e1fb64
--- /dev/null
+++ b/wgkex/broker/ipam_mqtt_test.py
@@ -0,0 +1,78 @@
+import ipaddress
+import json
+import unittest
+
+from wgkex.broker import multisite
+from wgkex.broker.ipam_mqtt import MQTTIPAM, key_id
+
+KEY_A = "wwdmDA0TcphfKPSEJr4Ff2D7msYpvO5ewLZ2wYKyaSo="
+KEY_B = "zMKj6ziPKqwWz2RQjdhxEmGn3FRFOzBUOI+4WgFkCSU="
+
+
+def _pair():
+    """Two brokers that share one (synchronous) MQTT bus."""
+    one = MQTTIPAM("pop-a", "2001:db8:a::/60")
+    two = MQTTIPAM("pop-a", "2001:db8:a::/60")
+    sent = []
+
+    def publish(topic, payload):
+        sent.append((topic, payload))
+        for ipam in (one, two):
+            ipam.on_message(payload)
+
+    one.publish = two.publish = publish
+    return one, two, sent
+
+
+class MQTTIPAMTest(unittest.TestCase):
+    def test_same_key_gets_same_prefix_on_both_brokers_before_sync(self):
+        one = MQTTIPAM("pop-a", "2001:db8:a::/56")
+        two = MQTTIPAM("pop-a", "2001:db8:a::/56")
+        one.publish = two.publish = lambda *_: None
+        self.assertEqual(
+            one.get_or_allocate_prefix(KEY_A, False, True)[1],
+            two.get_or_allocate_prefix(KEY_A, False, True)[1],
+        )
+
+    def test_allocation_is_shared_and_sticky(self):
+        one, two, sent = _pair()
+        _, prefix, _ = one.get_or_allocate_prefix(KEY_A, False, True)
+        self.assertEqual(prefix.prefixlen, 63)
+        self.assertNotEqual(prefix, ipaddress.IPv6Network("2001:db8:a::/63"))
+        self.assertEqual(sent[0][0], f"parker/ipam/pop-a/{key_id(KEY_A)}")
+        self.assertEqual(two.get_or_allocate_prefix(KEY_A, False, True)[1], prefix)
+        self.assertNotEqual(two.get_or_allocate_prefix(KEY_B, False, True)[1], prefix)
+
+        two.update_prefix(KEY_A, False, True, ["worker2", "worker1"])
+        self.assertEqual(
+            one.get_or_allocate_prefix(KEY_A, False, True)[2], ["worker1", "worker2"]
+        )
+        count = len(sent)
+        two.update_prefix(KEY_A, False, True, ["worker1", "worker2"])
+        self.assertEqual(len(sent), count)
+
+    def test_full_pool_and_bad_messages(self):
+        ipam = MQTTIPAM("pop-a", "2001:db8:a::/62")
+        ipam.publish = lambda *_: None
+        self.assertIsNotNone(ipam.get_or_allocate_prefix(KEY_A, False, True)[1])
+        self.assertIsNone(ipam.get_or_allocate_prefix(KEY_B, False, True)[1])
+        ipam.on_message(b"")
+        ipam.on_message(b"not json")
+        ipam.on_message(json.dumps({"PublicKey": KEY_B}).encode())
+        self.assertNotIn(KEY_B, ipam.ranges)
+
+    def test_multisite_routes_messages_by_pool(self):
+        ipam = MQTTIPAM("pop-a", "2001:db8:a::/56")
+        sites = {"pop-a": {"_ipam": ipam}, "pop-b": {"ipam_file": "x"}}
+        payload = json.dumps(
+            {"PublicKey": KEY_A, "Range6": "2001:db8:a:6::/63"}
+        ).encode()
+        multisite.ipam_message(sites, "parker/ipam/pop-b/k", payload)
+        multisite.ipam_message(sites, "parker/other/pop-a/k", payload)
+        self.assertEqual(ipam.ranges, {})
+        multisite.ipam_message(sites, f"parker/ipam/pop-a/{key_id(KEY_A)}", payload)
+        self.assertEqual(ipam.ranges, {KEY_A: "2001:db8:a:6::/63"})
+
+
+if __name__ == "__main__":
+    unittest.main()
