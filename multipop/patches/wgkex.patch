+import unittest
+
+from wgkex.worker import handshake_routes
+
+
+class _Peer:
+    def __init__(self, prefix, handshake):
+        self.attrs = {
+            "WGPEER_A_ALLOWEDIPS": [{"addr": prefix}],
+            "WGPEER_A_LAST_HANDSHAKE_TIME": {"tv_sec": handshake},
+        }
+
+    def get_attr(self, name):
+        return self.attrs.get(name)
+
+
+class HandshakeRoutesTest(unittest.TestCase):
+    def test_route_follows_fresh_handshake(self):
+        peers = [
+            _Peer("2001:db8:a::/63", 1000),
+            _Peer("2001:db8:a:2::/63", 700),
+            _Peer("2001:db8:a:4::/63", 0),
+        ]
+        self.assertEqual(
+            handshake_routes.wanted_routes(peers, 63, 180, 1100),
+            {
+                "2001:db8:a::/63": True,
+                "2001:db8:a:2::/63": False,
+                "2001:db8:a:4::/63": False,
+            },
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
