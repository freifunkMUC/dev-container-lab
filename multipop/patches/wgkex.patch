index 0000000..e8e2407
--- /dev/null
+++ b/wgkex/worker/handshake_routes.py
@@ -0,0 +1,91 @@
+"""LAB PROTOTYPE: install a node /63 route only while its handshake is fresh.
+
+In the multi-PoP design every pgw of a site has the peer of every node of the
+site. Only the pgw with a live session may announce the /63 of the node. So
+the route follows the handshake, and the peer stays.
+
+Set WGKEX_ROUTE_ON_HANDSHAKE=<seconds> (for example 180) to enable it.
+"""
+
+import os
+import socket
+import threading
+from time import time
+from typing import Callable, Dict, Optional
+
+import pyroute2
+import pyroute2.netlink.exceptions
+
+from wgkex.common import logger
+from wgkex.worker import netlink
+
+INTERFACE = "wg-nodes"
+SYNC_INTERVAL = 5.0
+
+
+def fresh_seconds() -> Optional[float]:
+    value = os.environ.get("WGKEX_ROUTE_ON_HANDSHAKE", "")
+    return float(value) if value else None
+
+
+def wanted_routes(
+    peers: list, prefix_length: int, fresh: float, now: float
+) -> Dict[str, bool]:
+    """Maps the /63 of each peer to True if its handshake is fresh."""
+    wanted: Dict[str, bool] = {}
+    for peer in peers:
+        try:
+            prefix = netlink._parker_prefix(peer, prefix_length)
+            handshake = netlink._last_handshake_seconds(peer)
+        except (ValueError, AttributeError):
+            continue
+        is_fresh = bool(handshake) and now - handshake < fresh
+        wanted[prefix] = wanted.get(prefix, False) or is_fresh
+    return wanted
+
+
+def sync_routes(
+    prefix_length: int, fresh: float, clock: Callable[[], float] = time
+) -> None:
+    with pyroute2.WireGuard() as wg:
+        peers = []
+        for msg in netlink._wireguard_info(wg, INTERFACE):
+            peers.extend(msg.get_attr("WGDEVICE_A_PEERS") or [])
+    wanted = wanted_routes(peers, prefix_length, fresh, clock())
+    with pyroute2.IPRoute() as ip:
+        oif = ip.link_lookup(ifname=INTERFACE)[0]
+        present = {
+            f"{route.get_attr('RTA_DST')}/{route['dst_len']}"
+            for route in ip.get_routes(family=socket.AF_INET6, oif=oif)
+            if route["dst_len"] == prefix_length
+        }
+        for prefix, is_fresh in wanted.items():
+            if is_fresh == (prefix in present):
+                continue
+            try:
+                ip.route("replace" if is_fresh else "del", dst=prefix, oif=oif)
+                logger.info(
+                    "Handshake route %s %s",
+                    "installed" if is_fresh else "removed",
+                    prefix,
+                )
+            except pyroute2.netlink.exceptions.NetlinkError as error:
+                logger.warning("Handshake route %s failed: %s", prefix, error)
+
+
+def start(exit_event: threading.Event, prefix_length: int) -> Optional[threading.Thread]:
+    fresh = fresh_seconds()
+    if fresh is None:
+        return None
+    logger.info("Routes follow handshakes (lab prototype), fresh=%ss", fresh)
+
+    def loop() -> None:
+        while not exit_event.wait(SYNC_INTERVAL):
+            try:
+                sync_routes(prefix_length, fresh)
+            except Exception as error:
+                logger.error("Handshake route sync failed", exc_info=error)
+
+    thread = threading.Thread(target=loop, name="handshake-routes")
+    thread.start()
+    return thread
