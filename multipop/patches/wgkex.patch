index 0000000..21eb459
--- /dev/null
+++ b/wgkex/broker/multisite.py
@@ -0,0 +1,203 @@
+"""LAB PROTOTYPE: per-site prefixes for the Parker multi-PoP design.
+
+Each site (PoP) has its own IPv6 parent prefix. A node gets one /63 from each
+site. The answer has one concentrator per site. It carries the prefixes of the
+site, the preferred pgw of the site, and a "pgws" list with all online pgws of
+the site. Every pgw of a site gets the /63 of that site. A node that does not
+send caps=multiprefix (old firmware) gets one site only, with the top-level
+fields only.
+
+The sites come from a JSON file (WGKEX_SITES_FILE, default
+/etc/wgkex-sites.json). Without that file, nothing changes:
+
+    {
+      "pop-a": {"site": "muc01", "pool6": "2001:db8:a::/50", "ipam": "mqtt",
+                "dns64": "2001:db8:a::53", "primary": true},
+      "pop-b": {"site": "vie01", "ipam_file": "/var/local/.../b.json",
+                "dns64": "2001:db8:b::53"}
+    }
+
+With "ipam": "mqtt", the allocations of the site are retained MQTT messages
+(ipam_mqtt.py), so several brokers share them and keep no state. Otherwise
+the site uses a JSON file (one broker only).
+"""
+
+import json
+import os
+from typing import Any, Dict, List, Optional, Tuple
+
+from wgkex.broker.ipam import ParkerIPAM
+from wgkex.broker.ipam_json import JSONFileIPAM
+from wgkex.broker.ipam_mqtt import TOPIC as IPAM_TOPIC, MQTTIPAM
+from wgkex.common import logger
+
+SITES_FILE = os.environ.get("WGKEX_SITES_FILE", "/etc/wgkex-sites.json")
+
+Answer = Tuple[List[Dict[str, Any]], Dict[str, str], Dict[str, str], str]
+
+
+def load_sites(path: str = SITES_FILE) -> Dict[str, Dict[str, Any]]:
+    if not os.path.exists(path):
+        return {}
+    with open(path, encoding="utf-8") as sites_file:
+        sites = json.load(sites_file)
+    logger.info("Multi-site mode (lab prototype): %s", sorted(sites))
+    for pop, site in sites.items():
+        if site.get("ipam") == "mqtt":
+            site["_ipam"] = MQTTIPAM(pop, site["pool6"])
+        else:
+            site["_ipam"] = JSONFileIPAM(site["ipam_file"])
+    return sites
+
+
+def site_ipam(site: Dict[str, Any]) -> ParkerIPAM:
+    ipam = site.get("_ipam")
+    if ipam is None:
+        ipam = site["_ipam"] = JSONFileIPAM(site["ipam_file"])
+    return ipam
+
+
+def mqtt_ipams(sites: Dict[str, Dict[str, Any]]) -> Dict[str, MQTTIPAM]:
+    return {
+        pop: site["_ipam"]
+        for pop, site in sites.items()
+        if isinstance(site.get("_ipam"), MQTTIPAM)
+    }
+
+
+def ipam_message(sites: Dict[str, Dict[str, Any]], topic: str, payload: bytes) -> None:
+    """Gives a retained allocation (parker/ipam/<pop>/<key id>) to its IPAM."""
+    parts = topic.split("/")
+    if len(parts) != 4 or "/".join(parts[:2]) != IPAM_TOPIC:
+        return
+    ipam = mqtt_ipams(sites).get(parts[2])
+    if ipam is not None:
+        ipam.on_message(payload)
+
+
+def site_prefixes(
+    sites: Dict[str, Dict[str, Any]], pubkey: str, length: int
+) -> Dict[str, Dict[str, str]]:
+    """Returns the prefixes of a node per PoP. A PoP without a free prefix is left out."""
+    result: Dict[str, Dict[str, str]] = {}
+    for pop, site in sites.items():
+        _, full, _ = site_ipam(site).get_or_allocate_prefix(
+            pubkey, False, True, 0, length
+        )
+        if full is None:
+            logger.error("No IPv6 range in site %s for %s", site.get("site"), pubkey)
+            continue
+        subnets = full.subnets(new_prefix=64)
+        range6 = next(subnets)
+        result[pop] = {
+            "site": site.get("site", pop),
+            "full_range6": str(full),
+            "range6": str(range6),
+            "xlat_range6": str(next(subnets)),
+            "node_address6": str(range6.network_address + 1),
+            "dns64": site.get("dns64", ""),
+        }
+    return result
+
+
+def primary_pop(sites: Dict[str, Dict[str, Any]]) -> str:
+    for pop in sorted(sites):
+        if sites[pop].get("primary"):
+            return pop
+    return sorted(sites)[0]
+
+
+def worker_range6(prefixes: Dict[str, Dict[str, str]], worker_cfg: Any) -> Optional[str]:
+    if worker_cfg is None or worker_cfg.pop not in prefixes:
+        return None
+    return prefixes[worker_cfg.pop]["full_range6"]
+
+
+def build_answer(
+    sites: Dict[str, Dict[str, Any]],
+    prefixes: Dict[str, Dict[str, str]],
+    pgws: Dict[str, List[Tuple[str, Dict[str, Any]]]],
+    preferred: Dict[str, str],
+    multiprefix: bool,
+) -> Optional[Answer]:
+    """Builds the concentrators of the answer.
+
+    Arguments:
+        prefixes: the node prefixes per PoP, from site_prefixes().
+        pgws: the online pgws per PoP as (worker name, concentrator entry).
+        preferred: the worker that get_best_workers() selected per PoP.
+        multiprefix: True if the node can use more than one site.
+
+    Returns:
+        (concentrators, {worker name: /63 to provision}, top-level prefixes,
+        primary site name), or None if no site has an online pgw.
+    """
+    live = [pop for pop in sorted(prefixes) if pgws.get(pop)]
+    if not live:
+        return None
+    primary = primary_pop(sites)
+    top_pop = primary if primary in live else live[0]
+    if not multiprefix:
+        live = [top_pop]
+    site_ids = {pop: index + 1 for index, pop in enumerate(sorted(sites))}
+
+    concentrators: List[Dict[str, Any]] = []
+    provisioned: Dict[str, str] = {}
+    for pop in live:
+        entries = dict(pgws[pop])
+        best = preferred.get(pop)
+        if best not in entries:
+            best = pgws[pop][0][0]
+        full_range6 = prefixes[pop]["full_range6"]
+        if not multiprefix:
+            concentrators.append(dict(entries[best]))
+            provisioned[best] = full_range6
+            continue
+        site = {k: v for k, v in prefixes[pop].items() if k != "full_range6"}
+        concentrators.append(
+            {
+                **entries[best],
+                **site,
+                # The id names the tunnel on the node (wg_c<id>). It is fixed
+                # per site, so a pgw switch keeps the tunnel.
+                "id": site_ids[pop],
+                "pgws": [
+                    {
+                        "id": entry["id"],
+                        "endpoint": entry["endpoint"],
+                        "pubkey": entry["pubkey"],
+                        "address6": entry["address6"],
+                        "preferred": name == best,
+                    }
+                    for name, entry in pgws[pop]
+                ],
+            }
+        )
+        for name, _ in pgws[pop]:
+            provisioned[name] = full_range6
+
+    top = prefixes[top_pop]
+    return (
+        concentrators,
+        provisioned,
+        {
+            "range6": top["range6"],
+            "xlat_range6": top["xlat_range6"],
+            "address6": top["node_address6"],
+        },
+        sites[primary].get("site", primary),
+    )
+
+
+def switch_target(
+    sites: Dict[str, Dict[str, Any]], workers: Dict[str, Any], old_id: int, new_id: int
+) -> Optional[str]:
+    """Returns the name of the old pgw after a pgw switch inside a site, or
+    None if the two pgws are not two different pgws of one known site."""
+    by_id = {cfg.id: (name, cfg.pop) for name, cfg in workers.items() if cfg}
+    old, new = by_id.get(old_id), by_id.get(new_id)
+    if old is None or new is None or old_id == new_id:
+        return None
+    if old[1] != new[1] or old[1] not in sites:
+        return None
+    return old[0]
