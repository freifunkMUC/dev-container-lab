+def on_message_drop_route(
+    client: mqtt.Client, userdata: Any, message: mqtt.MQTTMessage
+) -> None:
+    """LAB PROTOTYPE: the node moved to another pgw of the site. Remove its
+    route here at once and keep the peer (handshake_routes.drop_route).
+
+    The broker sends it retained on parker/drop-route/<worker>/<key id>, so
+    the message also arrives after an MQTT reconnect. The worker clears it
+    when it is done."""
+    parts = message.topic.split("/")
+    if len(parts) not in (3, 4) or parts[2] != _HOSTNAME:
+        return
+    if not message.payload:
+        return
+    # Only handshake_routes can put the route back later.
+    if handshake_routes.fresh_seconds() is None:
+        logger.warning("Ignoring drop-route: WGKEX_ROUTE_ON_HANDSHAKE is not set")
+        return
+    try:
+        data = json.loads(message.payload.decode("utf-8"))
+        public_key = data["PublicKey"]
+        if not isinstance(public_key, str) or not public_key:
+            raise ValueError("no PublicKey")
+        handshake_routes.drop_route(
+            public_key,
+            get_config().parker.prefixes.ipv6.length or 63,
+            at=data.get("Time"),
+        )
+    except Exception as error:
+        logger.warning("Ignoring drop-route message: %s", error)
+    if len(parts) == 4 and client is not None:
+        client.publish(message.topic, b"", qos=1, retain=True)
+
