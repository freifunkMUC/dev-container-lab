+@app.route("/api/health", methods=["GET"])
+def health() -> Tuple[Response | Dict, int]:
+    """LAB PROTOTYPE: the health check of the load balancer. Healthy only
+    while MQTT is connected and the retained state had time to arrive, so a
+    broker that cannot reach MQTT gets no requests."""
+    connected_at = mqtt_connected_at
+    if connected_at is None:
+        return {"status": "mqtt down"}, 503
+    if time.time() - connected_at < MQTT_SYNC_SECONDS:
+        return {"status": "syncing"}, 503
+    return {"status": "ok"}, 200
+
+
+@app.route("/api/v3/switch", methods=["POST"])
+def wg_api_v3_switch() -> Tuple[Response | Dict, int]:
+    """LAB PROTOTYPE: a node moved to another pgw of the same site and has a
+    fresh handshake with it. Tell the old pgw to drop the node route at once.
+    The old pgw keeps the peer, so the node can come back.
+
+    NOTE: the report is not authenticated in the lab. A real version must
+    check that the node signed it with its WireGuard key."""
+    if not sites:
+        return {"error": {"message": "Multi-site mode is not enabled"}}, 400
+    try:
+        pubkey = is_valid_wg_pubkey(request.values.get("pubkey", ""))
+        old_id = int(request.values.get("old", ""))
+        new_id = int(request.values.get("new", ""))
+    except Exception:
+        return {"error": {"message": "Invalid data received."}}, 400
+    old_name = multisite.switch_target(
+        sites, config.get_config().workers._workers, old_id, new_id
+    )
+    if old_name is None:
+        return {"error": {"message": "Not a pgw switch inside one site."}}, 400
+    # Retained, one topic per node: the old pgw gets it also when it was
+    # away from MQTT for a moment (for example, after an MQTT node failed).
+    # The time lets the worker ignore it if the node came back since then.
+    info = mqtt.client.publish(
+        f"parker/drop-route/{old_name}/{key_id(pubkey)}",
+        json.dumps({"PublicKey": pubkey, "Time": time.time()}).encode("utf-8"),
+        qos=1,
+        retain=True,
+    )
+    try:
+        info.wait_for_publish(2.0)
+    except Exception as error:
+        logger.warning("pgw switch of %s: publish failed: %s", pubkey, error)
+    if not info.is_published():
+        # The load balancer gives the request to another broker.
+        return {"error": {"message": "MQTT is not available."}}, 503
+    logger.info("pgw switch of %s: dropping route on %s", pubkey, old_name)
+    return {"dropped": old_name, "broker": _HOSTNAME}, 200
