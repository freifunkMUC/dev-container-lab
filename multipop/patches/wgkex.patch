+"""LAB PROTOTYPE: an IPAM that keeps its state in MQTT, so the brokers keep
+no state of their own (like the worker status they read from MQTT).
+
+Each allocation is a retained message on parker/ipam/<pool>/<key id>:
+{"PublicKey": ..., "Range6": ..., "Concentrators": [...]}. All brokers
+subscribe to parker/ipam/#, so each broker has the full table, also after
+a restart (the MQTT cluster keeps the retained messages).
+
+Two brokers can allocate at the same time. So the search for a free prefix
+starts at a position that comes from the hash of the public key: two
+brokers give the same node the same prefix, also before they see the
+message of the other broker. Two different nodes collide only if their
+hashes point to the same free prefix in the same moment.
+"""
+
+import base64
+import hashlib
+import ipaddress
+import json
+import threading
+from typing import Callable, Dict, List, Optional, Tuple
+
+from wgkex.broker.ipam import ParkerIPAM
+from wgkex.common import logger
+
+TOPIC = "parker/ipam"
+
+Publisher = Callable[[str, bytes], None]
+
+
+def key_id(pubkey: str) -> str:
+    """A topic-safe form of a WireGuard key (no '+', '/' or '=')."""
+    return base64.urlsafe_b64encode(base64.b64decode(pubkey)).decode().rstrip("=")
+
+
+class MQTTIPAM(ParkerIPAM):
+    def __init__(self, pool: str, parent_prefix: str) -> None:
+        self.pool = pool
+        self.parent_prefix = ipaddress.IPv6Network(parent_prefix)
+        self.ranges: Dict[str, str] = {}
+        self.concentrators: Dict[str, List[str]] = {}
+        self.lock = threading.RLock()
+        self.publish: Optional[Publisher] = None
+
+    def topic(self, pubkey: str) -> str:
+        return f"{TOPIC}/{self.pool}/{key_id(pubkey)}"
+
+    def _store(self, pubkey: str) -> None:
+        if self.publish is None:
+            logger.error("IPAM %s: no MQTT publisher, allocation not shared", self.pool)
+            return
+        self.publish(
+            self.topic(pubkey),
+            json.dumps(
+                {
+                    "PublicKey": pubkey,
+                    "Range6": self.ranges[pubkey],
+                    "Concentrators": self.concentrators.get(pubkey, []),
+                }
+            ).encode("utf-8"),
+        )
+
+    def on_message(self, payload: bytes) -> None:
+        """Takes an allocation that a broker (maybe this one) published."""
+        if not payload:
+            return
+        try:
+            data = json.loads(payload.decode("utf-8"))
+            pubkey = data["PublicKey"]
+            range6 = str(ipaddress.IPv6Network(data["Range6"]))
+            workers = [str(w) for w in data.get("Concentrators", [])]
+        except (ValueError, KeyError, TypeError) as error:
+            logger.warning("IPAM %s: ignoring message: %s", self.pool, error)
+            return
+        with self.lock:
+            self.ranges[pubkey] = range6
+            self.concentrators[pubkey] = workers
+
+    def _allocate(self, pubkey: str, length: int) -> Optional[str]:
+        count = 1 << (length - self.parent_prefix.prefixlen)
+        if count < 2:
+            return None
+        used = set(self.ranges.values())
+        digest = hashlib.sha256(pubkey.encode("utf-8")).digest()
+        # Index 0 is kept for the infrastructure, like in the JSON IPAM.
+        start = int.from_bytes(digest[:8], "big") % (count - 1)
+        base = int(self.parent_prefix.network_address)
+        step = 1 << (128 - length)
+        for n in range(count - 1):
+            index = 1 + (start + n) % (count - 1)
+            candidate = str(ipaddress.IPv6Network((base + index * step, length)))
+            if candidate not in used:
+                return candidate
+        return None
+
+    def get_or_allocate_prefix(
+        self,
+        pubkey: str,
+        ipv4: bool,
+        ipv6: bool,
+        ipv4_prefix_length: int = 22,
+        ipv6_prefix_length: int = 63,
+    ) -> Tuple[
+        Optional[ipaddress.IPv4Network], Optional[ipaddress.IPv6Network], List[str]
+    ]:
+        if ipv4:
+            raise NotImplementedError("Non-464XLAT mode not implemented in MQTTIPAM")
+        if not ipv6:
+            return None, None, []
+        with self.lock:
+            range6 = self.ranges.get(pubkey)
+            if range6 is None:
+                range6 = self._allocate(pubkey, ipv6_prefix_length)
+                if range6 is None:
+                    logger.error("IPAM %s: no free prefix for %s", self.pool, pubkey)
+                    return None, None, []
+                logger.info("IPAM %s: assigning %s to %s", self.pool, range6, pubkey)
+                self.ranges[pubkey] = range6
+                self._store(pubkey)
+            return (
+                None,
+                ipaddress.IPv6Network(range6),
+                list(self.concentrators.get(pubkey, [])),
+            )
+
+    def release_prefix(self, pubkey: str) -> None:
+        raise NotImplementedError
+
+    def update_prefix(
+        self, pubkey: str, ipv4: bool, ipv6: bool, selected_concentrators: List[str]
+    ) -> None:
+        if not ipv6:
+            return
+        with self.lock:
+            new = sorted(selected_concentrators)
+            if pubkey not in self.ranges or self.concentrators.get(pubkey) == new:
+                return
+            self.concentrators[pubkey] = new
+            self._store(pubkey)
diff --git a/wgkex/broker/ipam_mqtt_test.py b/wgkex/broker/ipam_mqtt_test.py
