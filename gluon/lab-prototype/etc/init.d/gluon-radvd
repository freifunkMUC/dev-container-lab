#!/bin/sh /etc/rc.common
# LAB PROTOTYPE: replaces the stock gluon-radvd init. Not upstream firmware.
# When parker-as writes /tmp/parker-as/ra-state: one patched uradvd
# (multipop/patches/uradvd.patch) with the fixed arguments from
# /tmp/parker-as/ra-args. It sends all prefixes in one RA and reads
# ra-state again on SIGHUP. Without ra-state: the stock single uradvd.
# shellcheck disable=SC2034,SC2046
START=50
USE_PROCD=1

start_service() {
  procd_open_instance
  if [ -r /tmp/parker-as/ra-state ] && [ -r /tmp/parker-as/ra-args ]; then
    procd_set_param command /usr/sbin/uradvd $(cat /tmp/parker-as/ra-args) --state-file /tmp/parker-as/ra-state
  else
    procd_set_param command /usr/sbin/uradvd $(/lib/gluon/radvd/arguments)
  fi
  procd_set_param respawn
  procd_set_param stderr 1
  procd_close_instance
}
