#!/bin/sh /etc/rc.common
# LAB PROTOTYPE: replaces the stock ebpf-clat init. Not upstream firmware.
# Same as stock, but each tunnel uses /tmp/xlat_range6.<iface> (the xlat /64
# of the site of that tunnel, written by parker-as) when the file exists.
# shellcheck disable=SC2034
USE_PROCD=1
START=21
STOP=89

start_instance() {
  iface="$1"
  [ -h "/sys/class/net/${iface}" ] || return 2
  conf="/tmp/xlat_range6.${iface}"
  [ -r "$conf" ] || conf=/tmp/xlat_range6
  [ -r "$conf" ] || return 3
  ifaceindex="$(cat "/sys/class/net/${iface}/ifindex")"
  xlat_range6="$(cut -d'/' -f1 "$conf")"
  procd_open_instance "ebpf-clat.${iface}"
  procd_set_param command /usr/sbin/ebpf-clat "${ifaceindex}" "${xlat_range6}" "64:ff9b::"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

start_service() {
  [ -x /usr/sbin/ebpf-clat ] || return 1
  for iface in $(wg show all public-key | cut -f1); do
    start_instance "$iface"
  done
}
