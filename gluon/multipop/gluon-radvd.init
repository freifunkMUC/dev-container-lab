#!/bin/sh /etc/rc.common
# LAB PROTOTYPE: once mp-node.sh writes /tmp/multipop/ra-state, start one
# patched uradvd that reads its prefixes and RDNSS from that file. mp-node
# sends SIGHUP when the file changes. Else as in Gluon.

USE_PROCD=1
START=50

start_service() {
	if [ -e /tmp/multipop/ra-state ]; then
		procd_open_instance
		# shellcheck disable=SC2046
		procd_set_param command /usr/sbin/uradvd -i br-client --state-file /tmp/multipop/ra-state \
			--pref64 64:ff9b::/96 $([ -r /tmp/adv_mtu ] && echo --adv-link-mtu "$(cat /tmp/adv_mtu)")
		procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi

	[ -x /lib/gluon/radvd/arguments ] || return 1

	procd_open_instance
	# shellcheck disable=SC2046
	procd_set_param command /usr/sbin/uradvd $(/lib/gluon/radvd/arguments)
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stderr 1
	procd_close_instance
}
