#!/bin/sh /etc/rc.common
# LAB PROTOTYPE: once mp-node.sh runs, start one uradvd per site with the
# arguments it writes to /tmp/multipop/radvd/<site>. Else as in Gluon.

USE_PROCD=1
START=50

start_service() {
	if [ -e /tmp/multipop/status ]; then
		for args in /tmp/multipop/radvd/*; do
			[ -r "$args" ] || continue
			procd_open_instance "${args##*/}"
			# shellcheck disable=SC2046
			procd_set_param command /usr/sbin/uradvd $(cat "$args")
			procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
			procd_set_param stderr 1
			procd_close_instance
		done
		return 0
	fi

	[ -x /lib/gluon/radvd/arguments ] || return 1

	procd_open_instance
	# shellcheck disable=SC2046
	procd_set_param command /usr/sbin/uradvd $(/lib/gluon/radvd/arguments)
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stderr 1
	procd_close_instance
}
