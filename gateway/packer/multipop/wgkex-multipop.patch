+@app.route("/api/v3/lab/switch", methods=["GET"])
+def wg_api_v3_lab_switch() -> Tuple[Response | Dict, int]:
+    """LAB PROTOTYPE (multi-PoP): a node moved to another pgw of a site.
+
+    The node calls this after a fresh handshake with the new pgw. The other
+    pgws of the site remove the node /63 at once and keep the peer.
+    """
+    lab = lab_multipop.settings(config.get_config().get("lab_multipop"))
+    if not lab:
+        return {"error": {"message": "lab_multipop is not enabled"}}, 400
+    pubkey = str(request.args.get("pubkey", ""))
+    site = str(request.args.get("site", ""))
+    pgw = str(request.args.get("pgw", ""))
+    if not lab_multipop.valid_pubkey(pubkey) or site not in lab["sites"]:
+        return {"error": {"message": "Invalid data received."}}, 400
+    others = lab_multipop.unroute_targets(
+        {
+            name: cfg.pop
+            for name in parker_worker_data
+            if (cfg := config.get_config().workers.get(name)) is not None
+        },
+        site,
+        pgw,
+    )
+    for name in others:
+        mqtt.publish(
+            f"parker/wireguard/{name}",
+            json.dumps({"PublicKey": pubkey, "LabUnroute": True}).encode("utf-8"),
+        )
+    logger.info("lab switch: %s site=%s pgw=%s unroute=%s", pubkey, site, pgw, others)
+    return {"unroute": others}, 200
+
