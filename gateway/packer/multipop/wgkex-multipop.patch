diff --git a/wgkex/broker/lab_multipop.py b/wgkex/broker/lab_multipop.py
new file mode 100644
index 0000000..1c800c4
--- /dev/null
+++ b/wgkex/broker/lab_multipop.py
@@ -0,0 +1,208 @@
+"""LAB PROTOTYPE: multi-PoP active/standby fields for the Parker config.
+
+Only used by dev-container-lab (branch multipop-active-standby). It reads the
+optional `lab_multipop` block of the config file:
+
+    lab_multipop:
+      home_site: muc            # the site the IPAM parent prefix belongs to
+      default_primary: muc
+      primary_site_by_source:   # node public source IP -> primary site
+        203.0.113.5: vie
+      sites:
+        muc: {parker_prefix: 2001:db8:100:4000::/50, dns64: 2001:db8:100::53, tunnel_id: 1}
+        vie: {parker_prefix: 2001:db8:200:4000::/50, dns64: 2001:db8:200::53, tunnel_id: 3}
+      gate: {handshake_max_age: 180}   # worker side, see worker/lab_gate.py
+      stateless_ipam: true      # HashIPAM below instead of the JSON file
+      trusted_proxies: [198.51.100.66]  # haproxy, its X-Forwarded-For is used
+
+Every node gets the same /63 offset in each site's Parker prefix. A worker's
+PoP name is its site name. A node that sends `caps=multiprefix` gets one
+tunnel per site (id = the site tunnel_id) and the list of all pgws of each
+site. Other nodes get only their primary site, as stock Parker config.
+
+The lab runs several brokers behind haproxy, as production does. A broker
+keeps no state of its own: the worker data comes from MQTT, the /63 comes
+from a hash of the public key (HashIPAM) and the preferred pgw of a site is
+the first online pgw by name. So every broker gives a node the same answer.
+Production uses NetBox as the shared IPAM instead.
+"""
+
+import base64
+import binascii
+import hashlib
+import ipaddress
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+from wgkex.broker.ipam import ParkerIPAM
+
+
+def settings(raw: Optional[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
+    if not raw or not raw.get("sites"):
+        return None
+    return raw
+
+
+def site_ranges(
+    lab: Dict[str, Any], full_range6: ipaddress.IPv6Network
+) -> Dict[str, ipaddress.IPv6Network]:
+    """The node's /63 in every site, at the offset it has in the home site."""
+    home = ipaddress.IPv6Network(lab["sites"][lab["home_site"]]["parker_prefix"])
+    offset = int(full_range6.network_address) - int(home.network_address)
+    result = {}
+    for name, site in lab["sites"].items():
+        parent = ipaddress.IPv6Network(site["parker_prefix"])
+        result[name] = ipaddress.IPv6Network(
+            (int(parent.network_address) + offset, full_range6.prefixlen)
+        )
+    return result
+
+
+class HashIPAM(ParkerIPAM):
+    """Stateless IPAM: the /63 of a node is a hash of its public key.
+
+    The first /63 of the parent stays reserved, as in JSONFileIPAM. Two keys
+    can get the same /63; with 8191 /63s in a /50 that is unlikely for the
+    few nodes of the lab. It holds no concentrator selection.
+    """
+
+    def __init__(self, parent_prefix: str) -> None:
+        self.parent = ipaddress.IPv6Network(parent_prefix)
+
+    def get_or_allocate_prefix(
+        self,
+        pubkey: str,
+        ipv4: bool,
+        ipv6: bool,
+        ipv4_prefix_length: int = 22,
+        ipv6_prefix_length: int = 63,
+    ) -> Tuple[
+        Optional[ipaddress.IPv4Network], Optional[ipaddress.IPv6Network], List[str]
+    ]:
+        if ipv4:
+            raise NotImplementedError("Non-464XLAT mode not implemented in HashIPAM")
+        if not ipv6:
+            return None, None, []
+        slots = 2 ** (ipv6_prefix_length - self.parent.prefixlen)
+        digest = int.from_bytes(hashlib.sha256(pubkey.encode()).digest()[:8], "big")
+        index = 1 + digest % (slots - 1)
+        size = 2 ** (128 - ipv6_prefix_length)
+        return None, ipaddress.IPv6Network(
+            (int(self.parent.network_address) + index * size, ipv6_prefix_length)
+        ), []
+
+    def release_prefix(self, pubkey: str) -> None:
+        pass
+
+    def update_prefix(
+        self, pubkey: str, ipv4: bool, ipv6: bool, selected_concentrators: List[str]
+    ) -> None:
+        pass
+
+
+def load_ipam(lab: Optional[Dict[str, Any]]) -> Optional[ParkerIPAM]:
+    if not isinstance(lab, dict) or lab.get("stateless_ipam") is not True:
+        return None
+    return HashIPAM(lab["sites"][lab["home_site"]]["parker_prefix"])
+
+
+def client_ip(lab: Dict[str, Any], headers: Any, remote_addr: Optional[str]) -> Optional[str]:
+    """The node address: X-Forwarded-For from a trusted proxy, else the peer.
+
+    haproxy overwrites X-Forwarded-For, so the header holds one address.
+    """
+    forwarded = str(headers.get("X-Forwarded-For", "") or "")
+    if remote_addr in (lab.get("trusted_proxies") or []) and forwarded:
+        return forwarded.split(",")[-1].strip()
+    return remote_addr
+
+
+def primary_site(lab: Dict[str, Any], source_ip: Optional[str]) -> str:
+    by_source = lab.get("primary_site_by_source") or {}
+    return str(by_source.get(source_ip, lab.get("default_primary", lab["home_site"])))
+
+
+def plan(
+    lab: Dict[str, Any],
+    full_range6: ipaddress.IPv6Network,
+    multiprefix: bool,
+    primary: str,
+    workers: List[Tuple[str, str, int]],
+    selected: List[str],
+    concentrator: Callable[[str, int], Dict[str, Any]],
+) -> Dict[str, Any]:
+    """Build the lab answer.
+
+    workers: (name, site, worker id) of every online, configured worker.
+    selected: names the stock selection picked (one per PoP). Not used: the
+    stock selection depends on the order the broker learned the workers in,
+    so two brokers can pick differently. The preferred pgw of a site is its
+    first online pgw by name.
+    concentrator(name, id): the stock concentrator entry for a worker.
+
+    Returns concentrators, mqtt targets (name -> Range6), keep (worker names
+    that must not get a Remove) and the extra top-level fields.
+    """
+    ranges = site_ranges(lab, full_range6)
+    sites: Dict[str, Dict[str, Any]] = {}
+    concentrators: List[Dict[str, Any]] = []
+    targets: Dict[str, str] = {}
+    names = [primary] if not multiprefix else list(lab["sites"])
+    for name in names:
+        site_cfg = lab["sites"][name]
+        pgws = sorted(w for w in workers if w[1] == name)
+        if not pgws:
+            continue
+        preferred = pgws[0]
+        subnets = ranges[name].subnets(new_prefix=64)
+        range6 = next(subnets)
+        xlat_range6 = next(subnets)
+        tunnel_id = int(site_cfg.get("tunnel_id", preferred[2]))
+        for w in pgws:
+            targets[w[0]] = str(ranges[name])
+        if multiprefix:
+            concentrators.append(
+                {**concentrator(preferred[0], preferred[2]), "id": tunnel_id}
+            )
+        else:
+            # Old firmware: stock Parker with all pgws of one site.
+            concentrators += [concentrator(w[0], w[2]) for w in pgws]
+        sites[name] = {
+            "range6": str(range6),
+            "xlat_range6": str(xlat_range6),
+            "address6": str(range6.network_address + 1),
+            "dns64": site_cfg.get("dns64"),
+            "concentrator": tunnel_id,
+            "pgws": [
+                {
+                    **concentrator(w[0], w[2]),
+                    "name": w[0],
+                    "preferred": w is preferred,
+                }
+                for w in pgws
+            ],
+        }
+    fields: Dict[str, Any] = {}
+    top = sites.get(primary) or next(iter(sites.values()), None)
+    if top is not None:
+        fields = {"range6": top["range6"], "xlat_range6": top["xlat_range6"],
+                  "address6": top["address6"]}
+        if multiprefix:
+            fields.update({"primary_site": primary, "sites": sites})
+    return {
+        "concentrators": concentrators,
+        "targets": targets,
+        "keep": {w[0] for w in workers},
+        "fields": fields,
+    }
+
+
+def valid_pubkey(pubkey: str) -> bool:
+    try:
+        return len(base64.b64decode(pubkey, validate=True)) == 32
+    except (binascii.Error, ValueError):
+        return False
+
+
+def unroute_targets(worker_sites: Dict[str, Any], site: str, pgw: str) -> List[str]:
+    """All pgws of `site` except the one the node uses now."""
+    return sorted(n for n, s in worker_sites.items() if s == site and n != pgw)
