@@ -0,0 +1,31 @@
+"""Tests for the lab gate (LAB PROTOTYPE)."""
+
+import unittest
+
+from wgkex.worker import lab_gate
+
+
+class LabGateTest(unittest.TestCase):
+    def test_only_fresh_handshakes_get_a_route(self):
+        peers = [
+            {"handshake": 1000, "allowed_ips": ["2001:db8:100:4002::/63", "fe80::2/128"]},
+            {"handshake": 800, "allowed_ips": ["2001:db8:100:4004::/63"]},
+            {"handshake": 0, "allowed_ips": ["2001:db8:100:4006::/63"]},
+        ]
+        self.assertEqual(
+            lab_gate.wanted_routes(peers, 1100, 180, 63), {"2001:db8:100:4002::/63"}
+        )
+
+    def test_unrouted_peer_needs_a_newer_handshake(self):
+        peers = [
+            {"pubkey": "A", "handshake": 1000, "allowed_ips": ["2001:db8:100:4002::/63"]},
+            {"pubkey": "B", "handshake": 1050, "allowed_ips": ["2001:db8:100:4004::/63"]},
+        ]
+        held = {"A": 1010, "B": 1010}
+        self.assertEqual(
+            lab_gate.wanted_routes(peers, 1100, 180, 63, held), {"2001:db8:100:4004::/63"}
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
