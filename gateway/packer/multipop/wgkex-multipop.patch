+import ipaddress
+import unittest
+
+from wgkex.broker import lab_multipop
+
+_LAB = {
+    "home_site": "muc",
+    "stateless_ipam": True,
+    "trusted_proxies": ["198.51.100.66"],
+    "sites": {"muc": {"parker_prefix": "2001:db8:100:4000::/50"}},
+}
+_KEY = "HCmk9FGT+iz27gS7HGE11Ai5Zwd4xe+hZcWgcUEPoSk="
+
+
+class TestLabMultipop(unittest.TestCase):
+    def test_hash_ipam_gives_every_broker_the_same_63(self):
+        a = lab_multipop.load_ipam(_LAB).get_or_allocate_prefix(_KEY, False, True)
+        b = lab_multipop.load_ipam(dict(_LAB)).get_or_allocate_prefix(_KEY, False, True)
+        self.assertEqual(a, b)
+        _, net, selected = a
+        parent = ipaddress.IPv6Network("2001:db8:100:4000::/50")
+        self.assertEqual(net.prefixlen, 63)
+        self.assertTrue(net.subnet_of(parent))
+        self.assertNotEqual(net.network_address, parent.network_address)
+        self.assertEqual(selected, [])
+        other = lab_multipop.load_ipam(_LAB).get_or_allocate_prefix(
+            "GNPCwrCQUZ+0cngV2R+jgTsCOj+eiMw0IXH6me6oLkI=", False, True
+        )[1]
+        self.assertNotEqual(net, other)
+
+    def test_no_hash_ipam_without_the_flag(self):
+        self.assertIsNone(lab_multipop.load_ipam({**_LAB, "stateless_ipam": False}))
+        self.assertIsNone(lab_multipop.load_ipam(None))
+
+    def test_client_ip_trusts_only_the_proxy(self):
+        headers = {"X-Forwarded-For": "203.0.113.5"}
+        self.assertEqual(lab_multipop.client_ip(_LAB, headers, "198.51.100.66"), "203.0.113.5")
+        self.assertEqual(lab_multipop.client_ip(_LAB, headers, "203.0.113.9"), "203.0.113.9")
+        self.assertEqual(lab_multipop.client_ip(_LAB, {}, "198.51.100.66"), "198.51.100.66")
+
+
+if __name__ == "__main__":
+    unittest.main()
