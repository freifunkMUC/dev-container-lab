diff --git a/wgkex/worker/lab_gate.py b/wgkex/worker/lab_gate.py
new file mode 100644
index 0000000..33b3821
--- /dev/null
+++ b/wgkex/worker/lab_gate.py
@@ -0,0 +1,161 @@
+"""LAB PROTOTYPE: announce a node /63 only while its tunnel is fresh.
+
+Only used by dev-container-lab (branch multipop-active-standby). With
+`lab_multipop.gate` in the config, the broker adds a node peer to all pgws of
+a site. Each pgw then keeps the peer, but installs the /63 route (and so the
+BGP announcement) only while the last handshake is younger than
+`handshake_max_age` seconds. The sync runs every `interval` seconds.
+
+When a node moves to another pgw of the same site, it reports the switch to
+the broker. The broker sends `LabUnroute` to the other pgws of the site, and
+unroute() removes the /63 at once. The route comes back only after a handshake
+that is newer than the unroute. The max age is only a safety net for a lost
+report.
+"""
+
+import ipaddress
+import logging
+import threading
+import time
+from typing import Any, Dict, Optional, Set
+
+import pyroute2
+
+from wgkex.config import config
+
+logger = logging.getLogger(__name__)
+
+_IFACE = "wg-nodes"
+
+# pubkey -> time of the last LabUnroute. Written by the MQTT thread.
+_held: Dict[str, float] = {}
+_lock = threading.Lock()
+_prefix_length = 63
+
+
+def settings() -> Optional[Dict[str, Any]]:
+    lab = config.get_config().get("lab_multipop") or {}
+    gate = lab.get("gate")
+    if gate is None:
+        return None
+    return {
+        "handshake_max_age": float(gate.get("handshake_max_age", 180)),
+        "interval": float(gate.get("interval", 1)),
+    }
+
+
+def enabled() -> bool:
+    try:
+        return settings() is not None
+    except Exception:  # config not loaded (unit tests)
+        return False
+
+
+def wanted_routes(
+    peers: list,
+    now: float,
+    max_age: float,
+    prefix_length: int,
+    held: Optional[Dict[str, float]] = None,
+) -> Set[str]:
+    """Return the /63 of every peer with a fresh handshake.
+
+    A peer in `held` needs a handshake newer than its unroute time.
+    """
+    result = set()
+    for peer in peers:
+        handshake = (peer.get("handshake") or 0)
+        if handshake <= 0 or now - handshake >= max_age:
+            continue
+        if handshake <= (held or {}).get(peer.get("pubkey") or "", 0):
+            continue
+        for addr in peer.get("allowed_ips", []):
+            net = ipaddress.ip_network(addr, strict=False)
+            if net.version == 6 and net.prefixlen == prefix_length:
+                result.add(str(net))
+    return result
+
+
+def _peers() -> list:
+    with pyroute2.WireGuard() as wg:
+        messages = wg.info(_IFACE)
+    peers = []
+    for message in messages:
+        for peer in message.get_attr("WGDEVICE_A_PEERS") or []:
+            hs = peer.get_attr("WGPEER_A_LAST_HANDSHAKE_TIME") or {}
+            pubkey = peer.get_attr("WGPEER_A_PUBLIC_KEY") or b""
+            if isinstance(pubkey, bytes):
+                pubkey = pubkey.decode("ascii")
+            peers.append(
+                {
+                    "pubkey": pubkey,
+                    "handshake": hs.get("tv_sec", 0) if isinstance(hs, dict) else 0,
+                    "allowed_ips": [
+                        a.get("addr")
+                        for a in peer.get_attr("WGPEER_A_ALLOWEDIPS") or []
+                        if isinstance(a, dict) and a.get("addr")
+                    ],
+                }
+            )
+    return peers
+
+
+def sync_once(prefix_length: int, max_age: float) -> Dict[str, Set[str]]:
+    with _lock:
+        return _sync(prefix_length, max_age)
+
+
+def _sync(prefix_length: int, max_age: float) -> Dict[str, Set[str]]:
+    now = time.time()
+    peers = _peers()
+    # Forget a hold once the peer handshakes again or is gone.
+    by_key = {p["pubkey"]: p.get("handshake") or 0 for p in peers}
+    for key in [k for k, t in _held.items() if by_key.get(k, now) > t]:
+        del _held[key]
+    wanted = wanted_routes(peers, now, max_age, prefix_length, _held)
+    with pyroute2.IPRoute() as ip:
+        oif = ip.link_lookup(ifname=_IFACE)[0]
+        current = {
+            f"{r.get_attr('RTA_DST')}/{r['dst_len']}"
+            for r in ip.get_routes(family=10, oif=oif)
+            if r["dst_len"] == prefix_length and r.get_attr("RTA_DST")
+        }
+        current = {str(ipaddress.ip_network(c)) for c in current}
+        for dst in wanted - current:
+            ip.route("replace", dst=dst, oif=oif)
+        for dst in current - wanted:
+            ip.route("del", dst=dst, oif=oif)
+    if wanted ^ current:
+        logger.info("lab gate: add=%s del=%s", sorted(wanted - current), sorted(current - wanted))
+    return {"add": wanted - current, "del": current - wanted}
+
+
+def unroute(pubkey: str) -> None:
+    """Remove the /63 of this peer now and keep the peer (LabUnroute)."""
+    gate = settings()
+    if gate is None or not pubkey:
+        return
+    with _lock:
+        _held[pubkey] = time.time()
+        result = _sync(_prefix_length, gate["handshake_max_age"])
+    logger.info("lab gate: unroute %s del=%s", pubkey, sorted(result["del"]))
+
+
+def start(exit_event: threading.Event, prefix_length: int) -> Optional[threading.Thread]:
+    global _prefix_length
+    gate = settings()
+    if gate is None:
+        return None
+    _prefix_length = prefix_length
+
+    def run() -> None:
+        while not exit_event.is_set():
+            try:
+                sync_once(prefix_length, gate["handshake_max_age"])
+            except Exception:
+                logger.exception("lab gate sync failed")
+            exit_event.wait(gate["interval"])
+
+    thread = threading.Thread(target=run, name="lab-gate", daemon=True)
+    thread.start()
+    return thread
