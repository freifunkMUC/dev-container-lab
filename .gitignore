**/*.qcow2
# The downloaded firmware image, its .gz and any backups next to it
gluon/*.img*

# Copy of the wgkex checkout that build.sh hands to Ansible
gateway/packer/wgkex-src/

# Packer's work directory (left behind when a build fails) and image cache
gateway/packer/output-*/
gateway/packer/packer_cache/

# Autogenerated by containerlab
clab-ffmuc*
.ffmuc.clab.yml.bak
__pycache__/
results/
artifacts/
# Copy of multipop/patches/uradvd.patch for the gluon build context
gluon/uradvd.patch
# ffbs environment: the staged copy of ffbs-ansible, containerlab files
gateway/packer/ffbs-stage/
clab-ffbs-lab/
envs/ffbs/.ffbs.clab.yml.bak
# Android SDK from android/fetch-sdk.sh, containerlab files
android/sdk/
clab-android-e2e/
android/.android.clab.yml.bak
envs/ffbs/lab/files/etcd-ca.pem
envs/ffbs/lab/files/concentrator*/
envs/ffbs/lab/files/node-config.sec
envs/ffbs/lab/files/node-config.pub
